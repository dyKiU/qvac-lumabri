{
  "name": "@lumabri/qvac-adapter",
  "version": "0.1.0",
  "description": "QVAC-to-Lumabri adapter for distributed MoE expert execution over RPC.",
  "type": "module",
  "types": "./dist/client.d.ts",
  "exports": {
    ".": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    },
    "./gateway-client": {
      "types": "./dist/lib/gateway-client.d.ts",
      "default": "./dist/lib/gateway-client.js"
    },
    "./prompt": {
      "types": "./dist/lib/prompt.d.ts",
      "default": "./dist/lib/prompt.js"
    },
    "./provider-pool": {
      "types": "./dist/lib/provider-pool.d.ts",
      "default": "./dist/lib/provider-pool.js"
    }
  },
  "files": [
    "dist/",
    "docs/",
    "contracts.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "bundle": "npm run build && node scripts/bundle.mjs",
    "bundle:cli": "npm run build && node node_modules/@qvac/cli/dist/index.js bundle sdk",
    "check": "npm run check:source && npm run typecheck && npm run check:types && npm run check:contracts && npm run check:hygiene && npm test",
    "check:contracts": "npm run build && node scripts/check-contracts.mjs && node scripts/render-contracts.mjs --check",
    "check:freshness": "node scripts/check-contract-freshness.mjs",
    "check:hygiene": "node scripts/check-release-hygiene.mjs",
    "check:native-upstreams": "node scripts/check-native-upstreams.mjs",
    "check:source": "node scripts/check-source.mjs",
    "check:types": "npm run build && tsc --noEmit --project tsconfig.types.json",
    "docs:contracts": "node scripts/render-contracts.mjs --write",
    "pack:check": "npm pack --dry-run",
    "prepack": "npm run build",
    "test": "npm run build && node --test test/gateway-client.test.js test/native-upstream-state.test.js test/prompt.test.js test/provider-pool.test.js",
    "test:qvac": "npm run build && node test/qvac-e2e.mjs",
    "test:qvac:ssh": "npm run build && node test/qvac-ssh-e2e.mjs",
    "test:physical": "npm run build && node test/physical-provider-e2e.mjs",
    "test:physical:provider": "node test/physical-provider-host.mjs",
    "verify:bundle": "node scripts/verify-qvac-bundle.mjs"
  },
  "engines": {
    "node": ">=20 <23"
  },
  "dependencies": {
    "bare-subprocess": "^6.1.0"
  },
  "peerDependencies": {
    "@qvac/sdk": "0.17.1 || 0.18.1",
    "zod": ">=4.4.3 <5.0.0"
  },
  "devDependencies": {
    "@qvac/cli": "0.12.0",
    "@qvac/sdk": "0.18.2",
    "@types/node": "20.19.24",
    "typescript": "5.9.3",
    "zod": "4.4.3"
  },
  "overrides": {
    "@fastify/static": "10.1.2"
  },
  "keywords": [
    "qvac",
    "lumabri",
    "moe",
    "rpc",
    "distributed-inference"
  ],
  "license": "Apache-2.0"
}
