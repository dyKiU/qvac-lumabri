+    char model[64];
+    char engine[1200];
+    char shim[1200];
+} GatewayCfg;
+
+static volatile sig_atomic_t g_gateway_engine_pid = 0;
+
+static void gateway_signal(int sig) {
+    sig_atomic_t pid = g_gateway_engine_pid;
+    if (pid > 0) kill((pid_t)pid, SIGTERM);
+    _exit(128 + sig);
+}
+
+static int write_full(int fd, const void *data, size_t len) {
+    const unsigned char *p = data;
+    while (len) {
+        ssize_t n = write(fd, p, len);
+        if (n < 0 && errno == EINTR) continue;
+        if (n <= 0) return -1;
+        p += (size_t)n;
+        len -= (size_t)n;
+    }
+    return 0;
+}
+
+static void json_string(FILE *out, const char *s) {
+    fputc('"', out);
+    for (const unsigned char *p = (const unsigned char *)s; *p; p++) {
+        switch (*p) {
+        case '"': fputs("\\\"", out); break;
+        case '\\': fputs("\\\\", out); break;
+        case '\b': fputs("\\b", out); break;
+        case '\f': fputs("\\f", out); break;
+        case '\n': fputs("\\n", out); break;
+        case '\r': fputs("\\r", out); break;
+        case '\t': fputs("\\t", out); break;
+        default:
+            if (*p < 0x20) fprintf(out, "\\u%04x", (unsigned)*p);
+            else fputc(*p, out);
+        }
+    }
+    fputc('"', out);
+}
+
+/* Gateway-produced ids/op/base64 are deliberately ASCII without escapes.
+ * This parser rejects escapes rather than silently interpreting a different
+ * request. It is sufficient for JSON.stringify output from the adapter. */
+static int json_ascii_field(const char *line, const char *key,
+                            char *out, size_t cap) {
+    char needle[80];
+    if (snprintf(needle, sizeof needle, "\"%s\"", key) >= (int)sizeof needle)
+        return -1;
+    const char *p = strstr(line, needle);
+    if (!p) return -1;
+    p += strlen(needle);
+    while (*p == ' ' || *p == '\t') p++;
+    if (*p++ != ':') return -1;
+    while (*p == ' ' || *p == '\t') p++;
+    if (*p++ != '"') return -1;
+    size_t n = 0;
+    while (*p && *p != '"') {
+        unsigned char c = (unsigned char)*p++;
+        if (c < 0x20 || c >= 0x7f || c == '\\' || n + 1 >= cap) return -1;
+        out[n++] = (char)c;
+    }
+    if (*p != '"') return -1;
+    out[n] = 0;
+    return 0;
+}
+
+static int json_int_field(const char *line, const char *key, long *out) {
+    char needle[80];
+    if (snprintf(needle, sizeof needle, "\"%s\"", key) >= (int)sizeof needle)
+        return -1;
+    const char *p = strstr(line, needle);
+    if (!p) return -1;
+    p += strlen(needle);
+    while (*p == ' ' || *p == '\t') p++;
+    if (*p++ != ':') return -1;
+    while (*p == ' ' || *p == '\t') p++;
+    char *end = NULL;
+    errno = 0;
+    long value = strtol(p, &end, 10);
+    if (errno || end == p || (*end != ',' && *end != '}' && *end != ' ' && *end != '\t'))
+        return -1;
+    *out = value;
+    return 0;
+}
+
+static int gateway_id_ok(const char *id) {
+    size_t n = strlen(id);
+    if (!n || n > 128) return 0;
+    for (size_t i = 0; i < n; i++) {
+        unsigned char c = (unsigned char)id[i];
+        if (!((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
+              (c >= '0' && c <= '9') || c == '-' || c == '_' ||
+              c == '.' || c == ':')) return 0;
+    }
+    return 1;
+}
+
+static const char B64[] =
+    "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+
+static char *base64_encode(const void *data, size_t len) {
+    const unsigned char *p = data;
+    size_t cap = 4 * ((len + 2) / 3) + 1, o = 0;
+    char *out = malloc(cap);
+    if (!out) return NULL;
+    for (size_t i = 0; i < len; i += 3) {
+        uint32_t v = (uint32_t)p[i] << 16;
+        int have2 = i + 1 < len, have3 = i + 2 < len;
+        if (have2) v |= (uint32_t)p[i + 1] << 8;
+        if (have3) v |= p[i + 2];
+        out[o++] = B64[(v >> 18) & 63];
+        out[o++] = B64[(v >> 12) & 63];
+        out[o++] = have2 ? B64[(v >> 6) & 63] : '=';
+        out[o++] = have3 ? B64[v & 63] : '=';
+    }
+    out[o] = 0;
+    return out;
+}
+
+static int b64_value(unsigned char c) {
+    if (c >= 'A' && c <= 'Z') return c - 'A';
+    if (c >= 'a' && c <= 'z') return c - 'a' + 26;
+    if (c >= '0' && c <= '9') return c - '0' + 52;
+    if (c == '+') return 62;
+    if (c == '/') return 63;
+    return -1;
+}
+
+static unsigned char *base64_decode(const char *src, size_t *out_len) {
+    size_t n = strlen(src), o = 0;
+    if ((n & 3) || n > 4 * ((GATEWAY_PROMPT_MAX + 2) / 3)) return NULL;
+    unsigned char *out = malloc(n / 4 * 3 + 1);
+    if (!out) return NULL;
+    for (size_t i = 0; i < n; i += 4) {
+        int a = b64_value((unsigned char)src[i]);
+        int b = b64_value((unsigned char)src[i + 1]);
+        int c = src[i + 2] == '=' ? -2 : b64_value((unsigned char)src[i + 2]);
+        int d = src[i + 3] == '=' ? -2 : b64_value((unsigned char)src[i + 3]);
+        int last = i + 4 == n;
+        if (a < 0 || b < 0 || c == -1 || d == -1 ||
+            (c == -2 && d != -2) || ((c == -2 || d == -2) && !last)) {
+            free(out); return NULL;
+        }
+        uint32_t v = (uint32_t)a << 18 | (uint32_t)b << 12;
+        if (c >= 0) v |= (uint32_t)c << 6;
+        if (d >= 0) v |= (uint32_t)d;
+        out[o++] = (unsigned char)(v >> 16);
+        if (c >= 0) out[o++] = (unsigned char)(v >> 8);
+        if (d >= 0) out[o++] = (unsigned char)v;
+    }
+    out[o] = 0;
+    *out_len = o;
+    return out;
+}
+
+static void gateway_error(const char *id, const char *message) {
+    fputs("{\"v\":1,\"id\":", stdout); json_string(stdout, id ? id : "");
+    fputs(",\"type\":\"error\",\"message\":", stdout); json_string(stdout, message);
+    fputs("}\n", stdout); fflush(stdout);
+}
+
+typedef struct { const char *id; } GatewaySink;
+
+static int gateway_chunk(const void *data, size_t len, void *arg) {
+    GatewaySink *s = arg;
+    char *encoded = base64_encode(data, len);
+    if (!encoded) return -1;
+    printf("{\"v\":1,\"id\":\"%s\",\"type\":\"delta\",\"data\":\"%s\"}\n",
+           s->id, encoded);
+    free(encoded);
+    return fflush(stdout) == 0 ? 0 : -1;
+}
+
+static int gateway_boot_engine(GatewayCfg *c, Engine *e) {
+    char mtype[64] = "";
+    if (c->local_dir) {
+        local_model_type(c->local_dir, mtype, sizeof mtype);
+    } else {
+        Swarm sw;
+        if (swarm_inspect(c->tracker, c->model, &sw)) {
+            fprintf(stderr, "lumabri gateway: model %s is not on swarm %s\n",
+                    c->model, c->tracker);
+            return -1;
+        }
+        snprintf(mtype, sizeof mtype, "%s", sw.model_type);
+    }
+    if (resolve_engine(c->engines_dir, c->engine_path, mtype,
+                       c->engine, sizeof c->engine)) {
+        fprintf(stderr, "lumabri gateway: engine not found: %s\n", c->engine);
+        return -1;
+    }
+    g_eng.booting = 1;
+    g_eng.last_out = nowd();
+    if (engine_spawn(c->engine, c->shim, c->tracker, c->model, c->local_dir,
+                     c->ctx, c->max_new, c->cap_experts, e)) {
+        g_eng.booting = 0;
+        fprintf(stderr, "lumabri gateway: cannot spawn engine\n");
+        return -1;
+    }
+    g_gateway_engine_pid = (sig_atomic_t)e->pid;
+    int rc = engine_wait_ready(e);
+    g_eng.booting = 0;
+    if (rc) {
+        fprintf(stderr, "lumabri gateway: engine did not become ready\n");
+        tail_dump(25);
+        engine_stop(e);
+        g_gateway_engine_pid = 0;
+        return -1;
+    }
+    return 0;
+}
+
+static int gateway_reset(Engine *e) {
+    if (e->proto == PROTO_FRAMED) {
+        static const char reset[] = "\x02RESET\n";
+        char stat[128];
+        if (write_full(e->to, reset, sizeof reset - 1)) return -1;
+        return stream_until_end_to(e, stat, sizeof stat, NULL, NULL);
+    }
+    /* OLMoE's CHAT dialect consumes /reset silently; this is the same
+     * contract used by the terminal front end. */
+    static const char reset[] = "/reset\n";
+    return write_full(e->to, reset, sizeof reset - 1);
+}
+
+static int gateway_generate(Engine *e, const char *id,
+                            const unsigned char *prompt, size_t prompt_len) {
+    if (!prompt_len) { gateway_error(id, "prompt is empty"); return 0; }
+    if (memchr(prompt, '\n', prompt_len) || memchr(prompt, '\r', prompt_len) ||
+        memchr(prompt, 0, prompt_len)) {
+        gateway_error(id, "prompt must be one engine-protocol line");
+        return 0;
+    }
+    if (gateway_reset(e)) { gateway_error(id, "engine reset failed"); return -1; }
+    if (write_full(e->to, prompt, prompt_len) || write_full(e->to, "\n", 1)) {
+        gateway_error(id, "engine input closed"); return -1;
+    }
+
+    char stat[128] = "";
+    double started = nowd();
+    if (e->proto == PROTO_FRAMED) {
+        GatewaySink sink = { id };
+        if (stream_until_end_to(e, stat, sizeof stat, gateway_chunk, &sink)) {
+            gateway_error(id, "engine exited during generation");
+            return -1;
+        }
+    } else {
+        char *reply = read_until_prompt(e->from);
+        if (!reply) { gateway_error(id, "engine exited during generation"); return -1; }
+        char *text = reply;
+        while (*text == '\n') text++;
+        int rc = gateway_chunk(text, strlen(text), &(GatewaySink){ id });
+        free(reply);
+        if (rc) return -1;
+    }
+
+    int ntok = 0;
+    double tps = 0, hit = 0, rss = 0;
+    int nstat = sscanf(stat, "STAT %d %lf %lf %lf", &ntok, &tps, &hit, &rss);
+    printf("{\"v\":1,\"id\":\"%s\",\"type\":\"done\",\"stats\":{"
+           "\"elapsedSeconds\":%.6f", id, nowd() - started);
+    if (nstat >= 1) printf(",\"generatedTokens\":%d", ntok);
+    if (nstat >= 2) printf(",\"tokensPerSecond\":%.6f", tps);
+    if (nstat >= 3) printf(",\"cacheHitPercent\":%.6f", hit);
+    if (nstat >= 4) printf(",\"residentGb\":%.6f", rss);
+    fputs("}}\n", stdout);
+    return fflush(stdout) == 0 ? 0 : -1;
+}
+
+static int cmd_gateway(int argc, char **argv) {
+    GatewayCfg c = {
+        .tracker = "127.0.0.1:7300", .ctx = 2048,
+        .max_new = 256, .cap_experts = 64
+    };
+    for (int i = 0; i < argc; i++) {
+        if (!strcmp(argv[i], "--tracker") && i + 1 < argc) c.tracker = argv[++i];
+        else if (!strcmp(argv[i], "--model") && i + 1 < argc) c.model_arg = argv[++i];
+        else if (!strcmp(argv[i], "--local") && i + 1 < argc) c.local_dir = argv[++i];
+        else if (!strcmp(argv[i], "--engine") && i + 1 < argc) c.engine_path = argv[++i];
+        else if (!strcmp(argv[i], "--engines-dir") && i + 1 < argc) c.engines_dir = argv[++i];
+        else if (!strcmp(argv[i], "--ctx") && i + 1 < argc) c.ctx = atoi(argv[++i]);
+        else if (!strcmp(argv[i], "--max-new") && i + 1 < argc) c.max_new = atoi(argv[++i]);
+        else if (!strcmp(argv[i], "--cap") && i + 1 < argc) c.cap_experts = atoi(argv[++i]);
+        else {
+            fprintf(stderr, "usage: lumabri gateway (--local DIR | --model NAME) "
+                            "[--tracker H:P] [--engine BIN] [--engines-dir DIR] "
+                            "[--ctx N] [--max-new N] [--cap N]\n");
+            return 2;
+        }
+    }
+    if (!!c.local_dir == !!c.model_arg || c.ctx <= 0 || c.max_new <= 0 ||
+        c.cap_experts <= 0) {
+        fprintf(stderr, "lumabri gateway: choose exactly one of --local or --model; "
+                        "numeric limits must be positive\n");
+        return 2;
+    }
+    if (c.local_dir) {
+        const char *base = strrchr(c.local_dir, '/');
+        snprintf(c.model, sizeof c.model, "%s", base && base[1] ? base + 1 : c.local_dir);
+    } else {
+        snprintf(c.model, sizeof c.model, "%s", c.model_arg);
+    }
+
+    char dir[1024];
+    exe_dir(dir, sizeof dir);
+    snprintf(c.shim, sizeof c.shim, "%s/liblumabri.so", dir);
+    if (access(c.shim, R_OK))
+        snprintf(c.shim, sizeof c.shim, "%s/../lib/lumabri/liblumabri.so", dir);
+    if (!c.local_dir && access(c.shim, R_OK)) {
+        fprintf(stderr, "lumabri gateway: liblumabri.so missing; run make or make install\n");
+        return 1;
+    }
+
+    signal(SIGINT, gateway_signal);
+    signal(SIGTERM, gateway_signal);
+    gateway_raise_nofile();
+    Engine e = {0};
+    if (gateway_boot_engine(&c, &e)) return 1;
+    fputs("{\"v\":1,\"type\":\"ready\",\"protocol\":", stdout);
+    json_string(stdout, e.proto == PROTO_FRAMED ? "framed" : "line");
+    fputs(",\"model\":", stdout); json_string(stdout, c.model);
+    fputs("}\n", stdout); fflush(stdout);
+
+    int rc = 0;
+    char *line = malloc(GATEWAY_LINE_MAX + 2);
+    if (!line) { engine_stop(&e); g_gateway_engine_pid = 0; return 1; }
+    for (;;) {
+        if (!fgets(line, (int)GATEWAY_LINE_MAX + 2, stdin)) break;
+        size_t got = strlen(line);
+        if (got > GATEWAY_LINE_MAX || (got && line[got - 1] != '\n' && !feof(stdin))) {
+            int ch;
+            while ((ch = fgetc(stdin)) != '\n' && ch != EOF) {}
+            gateway_error("", "request exceeds 2 MiB");
+            continue;
+        }
+        char id[129], op[32];
+        long version = 0;
+        if (json_int_field(line, "v", &version) || version != 1 ||
+            json_ascii_field(line, "id", id, sizeof id) || !gateway_id_ok(id) ||
+            json_ascii_field(line, "op", op, sizeof op)) {
+            gateway_error("", "invalid gateway request envelope");
+            continue;
+        }
+        if (!strcmp(op, "shutdown")) {
+            printf("{\"v\":1,\"id\":\"%s\",\"type\":\"bye\"}\n", id);
+            fflush(stdout);
+            break;
+        }
+        if (strcmp(op, "generate")) {
+            gateway_error(id, "unsupported operation");
+            continue;
+        }
+        char *encoded = malloc(GATEWAY_LINE_MAX + 1);
+        if (!encoded) { gateway_error(id, "out of memory"); rc = 1; break; }
+        if (json_ascii_field(line, "prompt", encoded, GATEWAY_LINE_MAX + 1)) {
+            free(encoded); gateway_error(id, "missing base64 prompt"); continue;
+        }
+        size_t prompt_len = 0;
+        unsigned char *prompt = base64_decode(encoded, &prompt_len);
+        free(encoded);
+        if (!prompt || prompt_len > GATEWAY_PROMPT_MAX) {
+            free(prompt); gateway_error(id, "invalid or oversized base64 prompt"); continue;
+        }
+        int grc = gateway_generate(&e, id, prompt, prompt_len);
+        free(prompt);
+        if (grc) { rc = 1; break; }
+    }
+    free(line);
+    engine_stop(&e);
+    g_gateway_engine_pid = 0;
+    return rc;
+}
