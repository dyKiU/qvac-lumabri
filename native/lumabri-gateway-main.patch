+/* ---- gateway: a process boundary for QVAC and other hosts --------------
+ *
+ * stdout is NDJSON and nothing else. Binary prompt/reply data is base64 so
+ * an engine read that splits a UTF-8 code point cannot create invalid JSON.
+ * One generate is active at a time, matching the one KV slot configured in
+ * engine_spawn. Each request resets the engine first: callers send complete
+ * rendered history and never inherit another session's cache accidentally.
+ *
+ * request:  {"v":1,"id":"1","op":"generate","prompt":"<base64>"}
+ * response: {"v":1,"id":"1","type":"delta","data":"<base64>"}
+ *           {"v":1,"id":"1","type":"done","stats":{...}}
+ */
+
+#define GATEWAY_LINE_MAX (2U * 1024U * 1024U)
+#define GATEWAY_PROMPT_MAX (1024U * 1024U)
+#define GATEWAY_NOFILE_TARGET ((rlim_t)4096)
+
+/* Large sharded models can exceed macOS's default soft limit of 256 files.
+ * Raise only the soft limit, never beyond the operator-controlled hard cap. */
+static void gateway_raise_nofile(void) {
+    struct rlimit limit;
+    if (getrlimit(RLIMIT_NOFILE, &limit) ||
+        limit.rlim_cur >= GATEWAY_NOFILE_TARGET) return;
+    limit.rlim_cur = limit.rlim_max < GATEWAY_NOFILE_TARGET
+        ? limit.rlim_max : GATEWAY_NOFILE_TARGET;
+    if (setrlimit(RLIMIT_NOFILE, &limit))
+        fprintf(stderr, "lumabri gateway: cannot raise open-file limit: %s\n",
+                strerror(errno));
+}
+
